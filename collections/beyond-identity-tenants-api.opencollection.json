{
  "opencollection": "1.0.0",
  "info": {
    "name": "Beyond Identity Secure Access Applications Tenants API",
    "version": "1.7.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tenants",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an Existing Tenant",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-us.beyondidentity.com/v1/tenants/:tenant_id",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "A unique identifier for a tenant."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "To retrieve an existing tenant, send a GET request to `/v1/tenants/$TENANT_ID`.\n"
        },
        {
          "info": {
            "name": "Patch a Tenant",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api-us.beyondidentity.com/v1/tenants/:tenant_id",
            "params": [
              {
                "name": "tenant_id",
                "value": "",
                "type": "path",
                "description": "A unique identifier for a tenant."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "To update only specific attributes of an existing tenant, send a PATCH request to `/v1/tenants/$TENANT_ID`. Values in the request body for immutable or read-only fields will be ignored. Fields that are omitted from the request body will be left unchanged.\n"
        }
      ]
    }
  ],
  "bundled": true
}